<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/avatarPhoto"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_centerVertical="true"
        android:src="@drawable/img_avatar_placeholder"
        app:civ_border_width="1.5dp"
        app:civ_border_color="@color/pink_primary"/>

    <TextView
        android:id="@+id/tvTopBarLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/avatarPhoto"
        android:layout_marginStart="10dp"
        android:text="@string/app_name"
        android:textColor="@color/pink_primary"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_bell"
        app:tint="@color/pink_primary"
        android:contentDescription="Notifikasi"/>

</RelativeLayout>