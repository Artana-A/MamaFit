<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink_bg_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Top Bar -->
        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/pink_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/avatarCircle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBell"/>

        <ImageView
            android:id="@+id/btnBell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/text_dark"
            android:contentDescription="Notifikasi"
            app:layout_constraintTop_toTopOf="@id/tvLogo"
            app:layout_constraintBottom_toBottomOf="@id/tvLogo"
            app:layout_constraintEnd_toStartOf="@id/avatarCircle"
            android:layout_marginEnd="16dp"/>

        <FrameLayout
            android:id="@+id/avatarCircle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="BP"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Foto Circle -->
        <FrameLayout
            android:id="@+id/photoCircle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_circle_photo"
            app:layout_constraintTop_toBottomOf="@id/tvLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.78">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp"
                android:scaleType="centerInside"
                android:src="@drawable/img_illustration"
                android:contentDescription="Ilustrasi ibu hamil berolahraga"/>
        </FrameLayout>

        <!-- Badge -->
        <LinearLayout
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@id/photoCircle"
            app:layout_constraintEnd_toEndOf="@id/photoCircle"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_badge_icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/skrining_badge"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Judul -->
        <TextView
            android:id="@+id/tvSkriningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/skrining_title"
            android:textColor="@color/pink_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/photoCircle"/>

        <TextView
            android:id="@+id/tvSkriningDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/skrining_desc"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvSkriningTitle"/>

        <!-- Info Box -->
        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_info_box"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvSkriningDesc">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo_icon">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    app:tint="@color/white"
                    android:contentDescription="Info"/>
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/skrining_info"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="italic"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnStartSkrining"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/infoBox">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_skrining"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/white"
                android:contentDescription="Panah"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimeEstimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/skrining_time_estimate"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btnStartSkrining"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>